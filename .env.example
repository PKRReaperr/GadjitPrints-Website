# PostgreSQL-compatible database used by the beta Preview deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate long random server secrets. Never use NEXT_PUBLIC_ for these values.
AUTH_SECRET=replace-with-a-random-value-at-least-32-bytes
CRON_SECRET=replace-with-a-random-value-at-least-16-bytes
# Base64 encoding of exactly 32 random bytes. Example generator: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# One-time administrator bootstrap. Generate the hash with npm run admin:hash-password.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD_HASH=$argon2id$placeholder-only

# OpenAI server integration. Fixture mode works without a live key.
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-5-mini
RADAR_FIXTURE_MODE=true
RADAR_CRON_ENABLED=false

# Etsy Preview app credentials. Use a beta-only Etsy app while testing.
ETSY_API_KEY=etsy-keystring-placeholder
ETSY_SHARED_SECRET=etsy-shared-secret-placeholder
ETSY_REDIRECT_URI=https://admin-beta.gadjitprints.store/api/admin/etsy/callback
ETSY_SCOPES=listings_r listings_w shops_r
ETSY_DRAFTS_ENABLED=false

# Vercel Blob store connected to the beta project.
BLOB_READ_WRITE_TOKEN=vercel_blob_placeholder
