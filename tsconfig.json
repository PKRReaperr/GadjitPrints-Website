{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "api/**/*.ts",
    "src/server/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "middleware.ts",
    "drizzle.config.ts"
  ]
}
